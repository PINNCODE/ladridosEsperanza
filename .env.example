# Copia este archivo como .env para desarrollo.
# true  → se muestran los registros con es_ejemplo: true y la cinta "Datos de ejemplo".
# Sin la variable (o con otro valor) → los ejemplos se filtran; así se compila el sitio real.
PUBLIC_MOSTRAR_EJEMPLOS=true

# Supabase (SPEC 06). Los valores locales salen de `npx supabase status` después de `npx supabase start`.
# Copia ahí la "Secret" (sb_secret_…); no se versiona porque GitHub bloquea llaves en el repositorio.
# La llave secreta se salta RLS: nunca lleva prefijo PUBLIC_ ni se usa en el navegador.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Navegador (SPEC 07): el formulario Súmate y el panel /admin hablan con Supabase con la llave publicable.
# La llave publicable sí puede estar en el navegador: RLS decide qué se lee y qué se escribe.
# Es la "Publishable" de `npx supabase status`; la local es la misma en todos los equipos.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# URL pública del sitio, sin diagonal final: `site` de Astro y destino de los QR de /admin/qr.
# En Vercel, la URL *.vercel.app y, después, el dominio propio.
PUBLIC_URL_SITIO=http://localhost:4321

# Analítica sin cookies con Umami Cloud (SPEC 11). El script se carga solo en la compilación de Production
# de Vercel (VERCEL_ENV=production), con el ID del sitio fijo en src/layouts/Layout.astro.
# PUBLIC_UMAMI_TABLERO es el enlace compartido de solo lectura; opcional y en Vercel solo en Production.
# Sin él no sale la tarjeta "Estadísticas" de /admin.
PUBLIC_UMAMI_TABLERO=

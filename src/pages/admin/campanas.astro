---
// /admin/campanas (SPEC 08, RF-12 y RF-24): campañas de esterilización, de la más nueva a la más vieja.
// El sitio muestra la próxima campaña y la última marcada como pasada.
import CabeceraLista from '../../components/admin/CabeceraLista.astro';
import { boton, etiquetaEjemplo, tarjeta } from '../../components/admin/estilos';
import LayoutPanel from '../../layouts/LayoutPanel.astro';
---

<LayoutPanel titulo="Campañas">
	<CabeceraLista agregar="/admin/campanas/editar" texto="Agregar campaña" />
	<p data-vacio hidden class="mt-6">Todavía no hay campañas.</p>
	<ul data-lista class="mt-6 space-y-3"></ul>

	<template data-plantilla>
		<li class={tarjeta}>
			<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h2 data-fecha class="text-lg font-bold first-letter:uppercase"></h2>
				<span data-ejemplo hidden class={etiquetaEjemplo}>Ejemplo</span>
			</div>
			<p data-detalle class="mt-1 break-words text-texto-secundario"></p>
			<div class="mt-3 flex flex-wrap gap-2">
				<a data-editar class={boton}>Editar</a>
				<button type="button" data-borrar class={boton}>Borrar</button>
			</div>
		</li>
	</template>
</LayoutPanel>

<script>
	import { confirmarBorrado, mensajeError, mostrarAviso } from '../../lib/formularioPanel';
	import { formatearFecha } from '../../lib/formato';
	import { borrarRutas } from '../../lib/imagenesPanel';
	import { prepararPanel } from '../../lib/panel';
	import { supabaseNavegador } from '../../lib/supabaseNavegador';

	type Campana = { id: string; fecha: string; lugar: string; estado: string; es_ejemplo: boolean };

	async function iniciar() {
		if (!(await prepararPanel())) return;
		const supabase = supabaseNavegador();
		mostrarAviso(document.querySelector<HTMLElement>('[data-aviso]')!);

		const { data, error } = await supabase
			.from('campanas')
			.select('id, fecha, lugar, estado, es_ejemplo')
			.order('fecha', { ascending: false })
			.overrideTypes<Campana[], { merge: false }>();
		if (error) {
			document.querySelector<HTMLElement>('[data-error-lista]')!.hidden = false;
			return;
		}

		const lista = document.querySelector<HTMLUListElement>('[data-lista]')!;
		const plantilla = document.querySelector<HTMLTemplateElement>('[data-plantilla]')!;
		const errorAccion = document.querySelector<HTMLElement>('[data-error-accion]')!;

		document.querySelector<HTMLElement>('[data-vacio]')!.hidden = data.length > 0;
		lista.replaceChildren(
			...data.map((campana) => {
				const fila = plantilla.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
				const fecha = formatearFecha(new Date(campana.fecha));
				fila.querySelector('[data-fecha]')!.textContent = fecha;
				fila.querySelector('[data-detalle]')!.textContent =
					`${campana.lugar} · ${campana.estado === 'proxima' ? 'Próxima' : 'Pasada'}`;
				fila.querySelector<HTMLElement>('[data-ejemplo]')!.hidden = !campana.es_ejemplo;
				fila.querySelector<HTMLAnchorElement>('[data-editar]')!.href =
					`/admin/campanas/editar?id=${encodeURIComponent(campana.id)}`;

				const borrar = fila.querySelector<HTMLButtonElement>('[data-borrar]')!;
				borrar.setAttribute('aria-label', `Borrar la campaña del ${fecha}`);
				borrar.addEventListener('click', async () => {
					if (!confirmarBorrado(`la campaña del ${fecha}`)) return;
					borrar.disabled = true;
					const { data: rutas, error: fallo } = await supabase.rpc('borrar_contenido', {
						tabla: 'campanas',
						id: campana.id,
					});
					if (fallo) {
						borrar.disabled = false;
						errorAccion.textContent = mensajeError(fallo, 'borrar');
						return;
					}
					await borrarRutas(rutas ?? []);
					location.reload();
				});
				return fila;
			}),
		);
	}

	iniciar();
</script>

---
// /admin/campanas/editar (SPEC 08, RF-12 y RF-24): crea (sin ?id=) o edita una campaña con su cartel.
// Guarda con la RPC guardar_campana; el id es la fecha con la que se creó.
import CampoFotos from '../../../components/admin/CampoFotos.astro';
import FormularioPanel from '../../../components/admin/FormularioPanel.astro';
import { ayuda, campo, etiqueta } from '../../../components/admin/estilos';
import LayoutPanel from '../../../layouts/LayoutPanel.astro';
---

<LayoutPanel titulo="Campaña">
	<FormularioPanel lista="/admin/campanas">
		<div class="grid gap-5 sm:grid-cols-2">
			<div>
				<label for="campana-fecha" class={etiqueta}>Fecha</label>
				<input id="campana-fecha" name="fecha" type="date" required class={campo} />
			</div>
			<div>
				<label for="campana-estado" class={etiqueta}>Estado</label>
				<select id="campana-estado" name="estado" required class={campo}>
					<option value="proxima">Próxima</option>
					<option value="pasada">Pasada</option>
				</select>
			</div>
			<div>
				<label for="campana-costo" class={etiqueta}>Costo ($)</label>
				<input
					id="campana-costo"
					name="costo"
					type="number"
					min="0"
					step="0.01"
					inputmode="decimal"
					required
					class={campo}
				/>
			</div>
			<div>
				<label for="campana-cupo" class={etiqueta}>
					Cupo <span class="font-normal text-texto-secundario">(opcional)</span>
				</label>
				<input id="campana-cupo" name="cupo" type="number" min="0" step="1" inputmode="numeric" class={campo} />
			</div>
		</div>
		<div>
			<label for="campana-lugar" class={etiqueta}>Lugar</label>
			<input id="campana-lugar" name="lugar" required maxlength="200" class={campo} />
		</div>
		<div>
			<label for="campana-horario" class={etiqueta}>Horario</label>
			<input id="campana-horario" name="horario" required maxlength="200" class={campo} />
		</div>
		<div>
			<label for="campana-pago" class={etiqueta}>Forma de pago</label>
			<textarea id="campana-pago" name="forma_pago" required rows="3" maxlength="1000" class={campo}></textarea>
			<p class={ayuda}>No escribas datos bancarios: el sitio pide escribir por WhatsApp para recibirlos.</p>
		</div>
		<CampoFotos id="campana-cartel" etiqueta="Cartel" carpeta="campanas" ladoMaximo={2400} maximo={1} />
	</FormularioPanel>
</LayoutPanel>

<script>
	import { avisoSitio, iniciarFormulario, texto } from '../../../lib/formularioPanel';
	import { campoFotos, guardarConFotos, type FotoGuardada } from '../../../lib/imagenesPanel';
	import { prepararPanel } from '../../../lib/panel';
	import { supabaseNavegador } from '../../../lib/supabaseNavegador';

	const campos = ['fecha', 'estado', 'costo', 'cupo', 'lugar', 'horario', 'forma_pago'] as const;

	type Campana = Record<(typeof campos)[number], string | number | null> & { cartel: FotoGuardada | null };

	let marcar = () => {};
	const cartel = campoFotos(document.querySelector('[data-campo-fotos]')!, () => marcar());

	if (await prepararPanel()) {
		const supabase = supabaseNavegador();
		const listo = await iniciarFormulario<Campana>({
			lista: '/admin/campanas',
			titulos: { nuevo: 'Nueva campaña', editar: 'Editar campaña' },
			cargar: (id) =>
				supabase
					.from('campanas')
					.select(`${campos.join(', ')}, cartel:imagenes(id, ruta)`)
					.eq('id', id)
					.maybeSingle<Campana>(),
			llenar: (campana, formulario) => {
				for (const nombre of campos) {
					(formulario.elements.namedItem(nombre) as HTMLInputElement).value = String(campana[nombre] ?? '');
				}
				if (campana.cartel) cartel.cargar([campana.cartel]);
			},
			guardar: async (formulario, id) => {
				const datos = new FormData(formulario);
				await guardarConFotos([cartel], ([fotos]) =>
					supabase.rpc('guardar_campana', {
						datos: {
							id,
							...Object.fromEntries(campos.map((nombre) => [nombre, texto(datos, nombre)])),
							cartel: fotos[0] ?? null,
						},
					}),
				);
				return avisoSitio;
			},
		});
		if (listo) marcar = listo.cambios.marcar;
	}
</script>

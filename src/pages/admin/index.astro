---
// /admin (SPEC 07 y 08): inicio del panel. Las dos cuentas ven las secciones del refugio;
// el administrador también ve las solicitudes nuevas y el enlace a los QR.
import Icono from '../../components/Icono.astro';
import LayoutPanel from '../../layouts/LayoutPanel.astro';

const tarjeta = 'flex min-h-11 items-start gap-3 rounded-2xl border border-lineas bg-superficie p-5 hover:border-acento';

const secciones = [
	{
		href: '/admin/peludos',
		icono: 'paw-print',
		titulo: 'Peludos',
		texto: 'Los peludos en adopción, con sus fotos y el orden del carrusel.',
	},
	{
		href: '/admin/campanas',
		icono: 'calendar-heart',
		titulo: 'Campañas',
		texto: 'Fechas, costo, lugar y cartel de las campañas de esterilización.',
	},
	{
		href: '/admin/necesidades',
		icono: 'package-open',
		titulo: 'Necesidades',
		texto: 'Lo que el refugio necesita este mes, con su urgencia y vigencia.',
	},
	{
		href: '/admin/cifras',
		icono: 'clipboard-list',
		titulo: 'Cifras del refugio',
		texto: 'Animales recibidos, rescates, adopciones, esterilizaciones y gastos de cada mes. No se publican.',
	},
];
---

<LayoutPanel titulo="Inicio">
	<div class="mt-6 grid gap-4 md:grid-cols-2">
		{
			secciones.map(({ href, icono, titulo, texto }) => (
				<a href={href} class={tarjeta}>
					<Icono nombre={icono} />
					<span>
						<span class="block text-xl font-bold">{titulo}</span>
						<span class="text-texto-secundario">{texto}</span>
					</span>
				</a>
			))
		}
		<a href="/admin/solicitudes" data-solo-administrador hidden class={tarjeta}>
			<Icono nombre="inbox" />
			<span>
				<span class="block text-xl font-bold">Solicitudes</span>
				<span data-nuevas class="text-texto-secundario">Contando solicitudes nuevas…</span>
			</span>
		</a>
		<a href="/admin/qr" data-solo-administrador hidden class={tarjeta}>
			<Icono nombre="qr-code" />
			<span>
				<span class="block text-xl font-bold">QR de negocios</span>
				<span class="text-texto-secundario">Descarga el QR de cada negocio en PNG o SVG.</span>
			</span>
		</a>
	</div>
</LayoutPanel>

<script>
	import { prepararPanel } from '../../lib/panel';
	import { supabaseNavegador } from '../../lib/supabaseNavegador';

	const cuenta = await prepararPanel();

	if (cuenta?.rol === 'administrador') {
		const { count, error } = await supabaseNavegador()
			.from('solicitudes_negocio')
			.select('id', { count: 'exact', head: true })
			.eq('estado', 'nueva');
		document.querySelector<HTMLElement>('[data-nuevas]')!.textContent = error
			? 'No pudimos contar las solicitudes nuevas.'
			: count === 1
				? '1 solicitud nueva'
				: `${count ?? 0} solicitudes nuevas`;
	}
</script>

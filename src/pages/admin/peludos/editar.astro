---
// /admin/peludos/editar (SPEC 08, RF-11 y RF-30): crea (sin ?id=) o edita un peludo con hasta 8 fotos,
// su convivencia y los hitos de su ficha (SPEC 13). Guarda con la RPC guardar_peludo; un peludo nuevo
// va al final del carrusel.
import AvisoBorrador from '../../../components/admin/AvisoBorrador.astro';
import CampoFotos from '../../../components/admin/CampoFotos.astro';
import CampoHitos from '../../../components/admin/CampoHitos.astro';
import FormularioPanel from '../../../components/admin/FormularioPanel.astro';
import { ayuda, campo, etiqueta } from '../../../components/admin/estilos';
import LayoutPanel from '../../../layouts/LayoutPanel.astro';

const convivencias = [
	{ nombre: 'convive_perros', texto: 'Convive con perros' },
	{ nombre: 'convive_gatos', texto: 'Convive con gatos' },
	{ nombre: 'convive_ninos', texto: 'Convive con niños' },
];
---

<LayoutPanel titulo="Peludo">
	<FormularioPanel lista="/admin/peludos">
		<AvisoBorrador />
		<div class="grid gap-5 sm:grid-cols-2">
			<div>
				<label for="peludo-nombre" class={etiqueta}>Nombre</label>
				<input id="peludo-nombre" name="nombre" required maxlength="60" class={campo} />
			</div>
			<div>
				<label for="peludo-estado" class={etiqueta}>Estado</label>
				<select id="peludo-estado" name="estado" required class={campo}>
					<option value="disponible">Disponible</option>
					<option value="en_proceso">En proceso</option>
					<option value="adoptado">Adoptado</option>
				</select>
			</div>
			<div>
				<label for="peludo-especie" class={etiqueta}>Especie</label>
				<select id="peludo-especie" name="especie" required class={campo}>
					<option value="perro">Perro</option>
					<option value="gato">Gato</option>
				</select>
			</div>
			<div>
				<label for="peludo-descripcion-especie" class={etiqueta}>Cómo se nombra</label>
				<input
					id="peludo-descripcion-especie"
					name="descripcion_especie"
					required
					maxlength="40"
					aria-describedby="peludo-descripcion-especie-ayuda"
					class={campo}
				/>
				<p id="peludo-descripcion-especie-ayuda" class={ayuda}>Por ejemplo "Perrita", "Cachorro" o "Gata".</p>
			</div>
			<div>
				<label for="peludo-edad" class={etiqueta}>Edad</label>
				<input id="peludo-edad" name="edad" required maxlength="40" placeholder="2 años" class={campo} />
			</div>
			<div>
				<label for="peludo-tamano" class={etiqueta}>Tamaño</label>
				<select id="peludo-tamano" name="tamano" required class={campo}>
					<option value="pequeño">Pequeño</option>
					<option value="mediano">Mediano</option>
					<option value="grande">Grande</option>
				</select>
			</div>
			<div>
				<label for="peludo-rasgo-1" class={etiqueta}>Rasgo 1</label>
				<input id="peludo-rasgo-1" name="rasgo_1" required maxlength="30" placeholder="Juguetona" class={campo} />
			</div>
			<div>
				<label for="peludo-rasgo-2" class={etiqueta}>Rasgo 2</label>
				<input id="peludo-rasgo-2" name="rasgo_2" required maxlength="30" placeholder="Cariñosa" class={campo} />
			</div>
		</div>
		<div>
			<label for="peludo-descripcion" class={etiqueta}>
				Descripción <span class="font-normal text-texto-secundario">(opcional)</span>
			</label>
			<textarea
				id="peludo-descripcion"
				name="descripcion"
				rows="4"
				maxlength="1000"
				aria-describedby="peludo-descripcion-ayuda"
				class={campo}></textarea>
			<p id="peludo-descripcion-ayuda" class={ayuda}>
				Su historia, en la ficha del peludo. Deja una línea en blanco entre párrafos.
			</p>
		</div>
		<div class="grid gap-5 sm:grid-cols-3">
			{
				convivencias.map(({ nombre, texto }) => (
					<div>
						<label for={`peludo-${nombre}`} class={etiqueta}>
							{texto}
						</label>
						<select id={`peludo-${nombre}`} name={nombre} required class={campo}>
							<option value="no_sabemos">No sabemos</option>
							<option value="si">Sí</option>
							<option value="no">No</option>
						</select>
					</div>
				))
			}
		</div>
		<CampoFotos id="peludo-fotos" etiqueta="Fotos" carpeta="peludos" ladoMaximo={1600} maximo={8} />
		<CampoHitos />
	</FormularioPanel>
</LayoutPanel>

<script>
	import {
		avisoSitio,
		iniciarFormulario,
		mostrarAvisoBorrador,
		texto,
		type PostFacebook,
	} from '../../../lib/formularioPanel';
	import { campoHitos, type Hito } from '../../../lib/hitosPanel';
	import { campoFotos, guardarConFotos, type FotoGuardada } from '../../../lib/imagenesPanel';
	import { prepararPanel } from '../../../lib/panel';
	import { supabaseNavegador } from '../../../lib/supabaseNavegador';

	const campos = [
		'nombre',
		'estado',
		'especie',
		'descripcion_especie',
		'edad',
		'tamano',
		'descripcion',
		'convive_perros',
		'convive_gatos',
		'convive_ninos',
	] as const;

	type Peludo = Record<(typeof campos)[number], string | null> & {
		rasgos: string[];
		fotos_peludo: { orden: number; imagen: FotoGuardada }[];
		hitos_peludo: (Hito & { orden: number })[];
		por_revisar: boolean;
		publicaciones_facebook: PostFacebook[];
	};

	let marcar = () => {};
	const fotos = campoFotos(document.querySelector('[data-campo-fotos]')!, () => marcar());
	const hitos = campoHitos(document.querySelector('[data-campo-hitos]')!, () => marcar());

	if (await prepararPanel()) {
		const supabase = supabaseNavegador();
		const listo = await iniciarFormulario<Peludo>({
			lista: '/admin/peludos',
			titulos: { nuevo: 'Nuevo peludo', editar: 'Editar peludo' },
			cargar: (id) =>
				supabase
					.from('peludos')
					.select(
						`${campos.join(', ')}, rasgos, fotos_peludo(orden, imagen:imagenes(id, ruta)), ` +
							'hitos_peludo(orden, fecha, tipo, texto, padrino), por_revisar, publicaciones_facebook(url_post, resultado)',
					)
					.eq('id', id)
					.maybeSingle<Peludo>(),
			llenar: (peludo, formulario) => {
				const campo = (nombre: string) => formulario.elements.namedItem(nombre) as HTMLInputElement;
				for (const nombre of campos) campo(nombre).value = peludo[nombre] ?? '';
				campo('rasgo_1').value = peludo.rasgos[0] ?? '';
				campo('rasgo_2').value = peludo.rasgos[1] ?? '';
				fotos.cargar(peludo.fotos_peludo.toSorted((a, b) => a.orden - b.orden).map(({ imagen }) => imagen));
				hitos.cargar(peludo.hitos_peludo.toSorted((a, b) => a.orden - b.orden));
				mostrarAvisoBorrador(peludo.por_revisar, peludo.publicaciones_facebook);
			},
			guardar: async (formulario, id) => {
				const datos = new FormData(formulario);
				await guardarConFotos([fotos], ([lista]) =>
					supabase.rpc('guardar_peludo', {
						datos: {
							id,
							...Object.fromEntries(campos.map((nombre) => [nombre, texto(datos, nombre)])),
							rasgos: [texto(datos, 'rasgo_1'), texto(datos, 'rasgo_2')],
							fotos: lista,
							hitos: hitos.leer(),
						},
					}),
				);
				return avisoSitio;
			},
		});
		if (listo) marcar = listo.cambios.marcar;
	}
</script>

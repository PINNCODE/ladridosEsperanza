---
// /colabora/sumate (SPEC 07, RF-15): formulario para que un negocio pida sumarse.
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import FormularioSumate from '../../components/colabora/FormularioSumate.astro';
import LayoutColabora from '../../layouts/LayoutColabora.astro';
import { mostrarNegocios, obtenerRefugio } from '../../lib/datos';

// Sin negocios (SPEC 17) la página es una redirección a la portada. En un sitio estático es un
// meta refresh sin código de estado; con 301 Astro lo hace inmediato (con 302 espera 2 s).
if (!mostrarNegocios) return Astro.redirect('/', 301);

const refugio = await obtenerRefugio();
const titulo = 'Suma tu negocio';
const frase = `Publicamos tu menú, horarios y promociones, y tu negocio aporta al refugio ${refugio.nombre}. Déjanos tus datos y te escribimos por WhatsApp.`;
---

<LayoutColabora titulo={`${titulo} · Come por los Peludos`} descripcion={frase}>
	<EncabezadoPagina titulo={titulo} frase={frase} icono="handshake" />
	<FormularioSumate />
</LayoutColabora>

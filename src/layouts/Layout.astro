---
import { Font } from 'astro:assets';
import AvisoMensaje from '../components/AvisoMensaje.astro';
import CintaEjemplo from '../components/CintaEjemplo.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { mostrarEjemplos, obtenerRefugio } from '../lib/datos';
import { imagenCompartir } from '../lib/fotosRefugio';
import type { Imagen } from '../lib/imagenes';
import { jsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
	/** Título completo de la pestaña. */
	titulo: string;
	/** Resumen de la página para buscadores y para compartir. */
	descripcion: string;
	/** Imagen para compartir; sin ella, la foto de los perros en la barda (SPEC 14). */
	imagen?: Imagen;
	/** Texto alternativo de `imagen` ("Logo de {negocio}"). */
	textoImagen?: string;
	/** false agrega <meta name="robots" content="noindex">. Por omisión, true. */
	indexar?: boolean;
	/** Objeto schema.org que se escribe como JSON-LD en <head>. */
	estructurados?: Record<string, unknown>;
	/** La barra del slot `barra` mide 60 px y no 48 (la de la ficha de un peludo, SPEC 13). */
	barraAlta?: boolean;
}

const { titulo, descripcion, imagen, textoImagen, indexar = true, estructurados, barraAlta = false } = Astro.props;
const refugio = await obtenerRefugio();

// Analítica sin cookies (SPEC 11): el script de Umami solo va en la compilación de Production
// de Vercel, así las vistas previas y el desarrollo no suman visitas. El ID del sitio es público.
const umami = process.env.VERCEL_ENV === 'production' ? '772ee111-f6dc-4300-83c5-f11dbf311746' : null;

// Etiquetas para compartir (SPEC 11): el logo de un negocio va en tarjeta chica (summary)
// y la foto del refugio en tarjeta grande. Las URL de Supabase ya son absolutas; la foto del
// refugio sale del repo en 1200 × 630 e imagenCompartir() la vuelve absoluta (SPEC 14).
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const compartir = imagen
	? { ...imagen, alt: textoImagen ?? titulo, tarjeta: 'summary' }
	: {
			...(await imagenCompartir(Astro.site!)),
			alt: `Perros del refugio ${refugio.nombre} asomados a la barda`,
			tarjeta: 'summary_large_image',
		};

// Las páginas de /colabora (SPEC 04, RF-13) y la ficha de cada peludo (SPEC 13) traen barra fija inferior. Con ella,
// viewport-fit=cover hace que env(safe-area-inset-bottom) mida la barra de inicio del
// teléfono, y el relleno inferior evita que la barra tape el pie.
const conBarra = Astro.slots.has('barra');
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content={`width=device-width, initial-scale=1${conBarra ? ', viewport-fit=cover' : ''}`}
		/>
		<meta name="description" content={descripcion} />
		{!indexar && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonica} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={refugio.nombre} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		<meta property="og:image" content={compartir.url} />
		<meta property="og:image:width" content={String(compartir.ancho)} />
		<meta property="og:image:height" content={String(compartir.alto)} />
		<meta property="og:image:alt" content={compartir.alt} />
		<meta name="twitter:card" content={compartir.tarjeta} />
		{estructurados && <script is:inline type="application/ld+json" set:html={jsonLd(estructurados)} />}
		<link rel="icon" href="/favicon.ico?v=2" sizes="any" />
		<link rel="icon" type="image/png" href="/icono.png?v=2" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--fuente-titulos" preload />
		<Font cssVariable="--fuente-texto" preload />
		<title>{titulo}</title>
		{
			umami && (
				<script
					is:inline
					defer
					src="https://cloud.umami.is/script.js"
					data-website-id={umami}
					data-domains={Astro.site!.hostname}
					data-exclude-search="true"
					data-exclude-hash="true"
					data-do-not-track="true"
				/>
			)
		}
	</head>
	<body
		class:list={[
			'flex min-h-dvh flex-col',
			conBarra &&
				(barraAlta ? 'pb-[calc(3.75rem+env(safe-area-inset-bottom))]' : 'pb-[calc(3rem+env(safe-area-inset-bottom))]'),
		]}
	>
		{mostrarEjemplos && <CintaEjemplo />}
		<Encabezado />
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
			<slot />
		</main>
		<Pie />
		<slot name="barra" />
		<AvisoMensaje barra={conBarra ? (barraAlta ? 'alta' : 'baja') : 'ninguna'} />
	</body>
</html>

---
import { Font } from 'astro:assets';
import CintaEjemplo from '../components/CintaEjemplo.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { mostrarEjemplos } from '../lib/datos';
import '../styles/global.css';

interface Props {
	/** Título completo de la pestaña. */
	titulo: string;
	/** Resumen de la página para buscadores y para compartir. */
	descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={descripcion} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--fuente-titulos" preload />
		<Font cssVariable="--fuente-texto" preload />
		<title>{titulo}</title>
	</head>
	<body class="flex min-h-dvh flex-col">
		{mostrarEjemplos && <CintaEjemplo />}
		<Encabezado />
		<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
			<slot />
		</main>
		<Pie />
	</body>
</html>

---
// Tarjeta de un peludo en adopción (SPEC 13): foto grande 4:5 con nombre y edad encima, cuántas fotos
// tiene y el corazón de "me gusta". Toda la tarjeta lleva a su ficha /adopta/{id}; el corazón no navega.
// La usan la galería de /adopta y el carrusel de la portada.
import { Image } from 'astro:assets';
import BotonMeGusta from './BotonMeGusta.astro';
import Icono from './Icono.astro';
import type { Peludo } from '../lib/datos';
import { medidas } from '../lib/imagenes';

interface Props {
	peludo: Peludo;
	origen: 'galeria' | 'portada';
}

const { peludo, origen } = Astro.props;
const { id, data } = peludo;
const [foto] = data.fotos;
---

<article class="relative overflow-hidden rounded-2xl bg-suave">
	<a
		href={`/adopta/${id}`}
		data-umami-event="abrir_peludo"
		data-umami-event-peludo={data.nombre}
		data-umami-event-origen={origen}
		class="group block"
	>
		{
			foto ? (
				<Image
					src={foto.url}
					{...medidas(foto, 480)}
					alt={`Foto de ${data.nombre}`}
					class="aspect-[4/5] w-full object-cover transition-transform duration-300 group-hover:scale-105"
				/>
			) : (
				<div class="grid aspect-[4/5] w-full place-items-center text-sobre-suave">
					<Icono nombre={data.especie === 'gato' ? 'cat' : 'dog'} size={72} />
				</div>
			)
		}
		<div
			class:list={[
				'absolute inset-x-0 bottom-0 p-4 pt-14',
				foto ? 'bg-linear-to-t from-black/75 via-black/40 to-transparent text-white' : 'text-sobre-suave',
			]}
		>
			<h3 class="text-xl font-bold">{data.nombre}</h3>
			<p class="text-sm">{data.descripcion_especie} · {data.edad}</p>
		</div>
	</a>
	{
		data.fotos.length > 1 && (
			<span class="pointer-events-none absolute top-2 left-2 inline-flex min-h-8 items-center gap-1 rounded-full bg-black/60 px-2.5 text-sm font-bold text-white">
				<Icono nombre="images" tono="heredado" size={16} />
				{data.fotos.length}
				<span class="sr-only">fotos</span>
			</span>
		)
	}
	<div class="absolute top-2 right-2">
		<BotonMeGusta id={id} nombre={data.nombre} origen={origen} />
	</div>
</article>


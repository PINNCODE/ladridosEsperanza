---
// Formas de ayudar (RF-25): 6 tarjetas con texto fijo. Ningún dato bancario se publica:
// los datos para donar se piden por WhatsApp al número oficial del refugio. La foto de "Donar en
// especie" es de la SPEC 14.
import { Image } from 'astro:assets';
import Icono from '../Icono.astro';
import ListaNecesidades from '../ListaNecesidades.astro';
import { bloquesDeSeccion, obtener, obtenerRefugio } from '../../lib/datos';
import { parrafos } from '../../lib/formato';
import { fotosRefugio } from '../../lib/fotosRefugio';
import { enlaceWhatsApp } from '../../lib/whatsapp';

const refugio = await obtenerRefugio();
const redes = (await obtener('redes')).sort((a, b) => a.data.orden - b.data.orden);
const [voluntariado] = await bloquesDeSeccion('voluntariado');

const whatsapp = (mensaje: string) => enlaceWhatsApp(refugio.whatsapp, mensaje);
const pedirDatos = whatsapp(`Hola, quiero los datos para donar a ${refugio.nombre}.`);
const apadrinar = whatsapp(`Hola, quiero apadrinar a un peludo de ${refugio.nombre}.`);
const serVoluntario = whatsapp(`Hola, quiero ser voluntario o dar hogar temporal en ${refugio.nombre}.`);

const tarjeta = 'flex flex-col rounded-2xl border border-lineas bg-superficie p-5';
const botonPrincipal =
	'mt-4 inline-flex min-h-11 items-center self-start rounded-xl bg-acento px-5 font-bold text-sobre-acento';
const botonSecundario =
	'inline-flex min-h-11 items-center rounded-xl border border-acento bg-superficie px-4 font-bold text-acento';
---

<section aria-labelledby="formas-titulo" class="mt-6">
	<h2 id="formas-titulo" class="text-2xl font-bold md:text-3xl">Formas de ayudar</h2>
	<div class="mt-4 grid gap-4 md:grid-cols-2">
		<article class={tarjeta}>
			<Icono nombre="landmark" />
			<h3 class="mt-3 text-lg font-bold">Transferencia o depósito</h3>
			<p class="mt-1 text-texto-secundario">Pide los datos oficiales por WhatsApp para donar con seguridad.</p>
			<a
				href={pedirDatos}
				target="_blank"
				rel="noopener"
				class={botonPrincipal}
				data-umami-event="whatsapp"
				data-umami-event-motivo="donativo"
			>
				Pedir datos para donar
			</a>
			<p class="mt-3 flex gap-2 rounded-xl bg-suave p-3 text-sm text-sobre-suave">
				<Icono nombre="shield-check" size={20} />
				El único canal oficial para donar es el WhatsApp del refugio. No publicamos cuentas bancarias en
				esta página.
			</p>
		</article>

		<article class={tarjeta}>
			<Image
				src={fotosRefugio.gatosComiendo.src}
				width={960}
				widths={[320, 480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
				alt={fotosRefugio.gatosComiendo.alt}
				style={{ objectPosition: fotosRefugio.gatosComiendo.enfoque }}
				class="mb-4 aspect-[4/3] w-full rounded-xl object-cover"
			/>
			<Icono nombre="package" />
			<h3 class="mt-3 text-lg font-bold">Donar en especie</h3>
			<p class="mt-1 text-texto-secundario">
				Croquetas, medicinas, cobijas y artículos de limpieza. Mira lo que hace falta este mes.
			</p>
			<ListaNecesidades nivel="h4" class="mt-4" />
		</article>

		<article class={tarjeta}>
			<Icono nombre="hand-heart" />
			<h3 class="mt-3 text-lg font-bold">Apadrina a un peludo</h3>
			<p class="mt-1 text-texto-secundario">
				Con un aporte cada mes ayudas a cubrir la comida y la atención de un peludo mientras encuentra
				familia. Escríbenos y te contamos cómo funciona.
			</p>
			<a
				href={apadrinar}
				target="_blank"
				rel="noopener"
				class={botonPrincipal}
				data-umami-event="whatsapp"
				data-umami-event-motivo="apadrinar"
			>
				Quiero apadrinar
			</a>
		</article>

		<article class={tarjeta}>
			<Icono nombre="users" />
			<h3 class="mt-3 text-lg font-bold">Voluntariado y hogar temporal</h3>
			<p class="mt-1 text-texto-secundario">Tu tiempo y tu casa también salvan vidas.</p>
			{voluntariado && parrafos(voluntariado.data.texto).map((parrafo) => <p class="mt-2">{parrafo}</p>)}
			<a
				href={serVoluntario}
				target="_blank"
				rel="noopener"
				class={botonPrincipal}
				data-umami-event="whatsapp"
				data-umami-event-motivo="voluntariado"
			>
				Quiero ser voluntario
			</a>
		</article>

		<article class={tarjeta}>
			<Icono nombre="share-2" />
			<h3 class="mt-3 text-lg font-bold">Comparte</h3>
			<p class="mt-1 text-texto-secundario">
				Compartir las publicaciones del refugio ayuda a que más personas adopten y donen.
			</p>
			<ul class="mt-4 flex flex-wrap gap-2" aria-label="Redes del refugio">
				{
					redes.map(({ data }) => (
						<li>
							<a href={data.url} target="_blank" rel="noopener" class={botonSecundario}>
								{data.etiqueta}
							</a>
						</li>
					))
				}
			</ul>
		</article>

		<article class={tarjeta}>
			<Icono nombre="store" />
			<h3 class="mt-3 text-lg font-bold">Come en negocios que ayudan</h3>
			<p class="mt-1 text-texto-secundario">
				Negocios locales aportan al refugio cuando publican su menú con nosotros.
			</p>
			<a href="/colabora" class={`mt-4 self-start ${botonSecundario}`}>Ver negocios</a>
		</article>
	</div>
</section>

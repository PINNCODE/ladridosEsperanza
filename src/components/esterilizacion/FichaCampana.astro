---
// Ficha de la próxima campaña (RF-12, RF-24), fecha de la última y cartel ampliable.
// Publicar una nueva fecha la cambia aquí y en la portada: las dos usan proximaCampana.
import EnlaceMessenger from '../EnlaceMessenger.astro';
import VisorCartel from '../VisorCartel.astro';
import { campanaAnterior, proximaCampana } from '../../lib/datos';
import { formatearFecha, formatearPesos } from '../../lib/formato';

const campana = await proximaCampana(new Date());
const anterior = await campanaAnterior();

const datos = campana && [
	{ etiqueta: 'Fecha', valor: formatearFecha(campana.data.fecha) },
	{ etiqueta: 'Costo', valor: formatearPesos(campana.data.costo) },
	{ etiqueta: 'Lugar', valor: campana.data.lugar },
	{ etiqueta: 'Horario', valor: campana.data.horario },
	...(campana.data.cupo !== null ? [{ etiqueta: 'Cupo', valor: `${campana.data.cupo} lugares` }] : []),
];

const reservar =
	campana && `Hola, quiero reservar un lugar para la campaña de esterilización del ${formatearFecha(campana.data.fecha)}.`;

// El cartel de la próxima campaña o, si no tiene, el de la anterior con su leyenda.
const conCartel = campana?.data.cartel ? campana : anterior?.data.cartel ? anterior : null;
const cartel = conCartel && {
	imagen: conCartel.data.cartel!,
	alt: `Cartel de la campaña de esterilización del ${formatearFecha(conCartel.data.fecha)}`,
	leyenda: conCartel === anterior ? 'Cartel de la campaña anterior' : undefined,
};
---

<section aria-labelledby="campana-titulo" class="mt-10 rounded-3xl bg-suave p-5 md:p-8">
	<h2 id="campana-titulo" class="text-2xl font-bold md:text-3xl">Próxima campaña</h2>
	<div class="mt-4 grid gap-6 md:grid-cols-[1fr_auto]">
		<div class="rounded-2xl bg-superficie p-5">
			{
				datos ? (
					<>
						<dl class="divide-y divide-lineas">
							{datos.map(({ etiqueta, valor }) => (
								<div class="flex justify-between gap-4 py-2">
									<dt class="text-texto-secundario">{etiqueta}</dt>
									<dd class="text-right font-bold">{valor}</dd>
								</div>
							))}
						</dl>
						<p class="mt-3 text-sm text-texto-secundario">{campana.data.forma_pago}</p>
						<EnlaceMessenger
							mensaje={reservar!}
							motivo="esterilizacion"
							class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-acento px-5 font-bold text-sobre-acento"
						>
							Reservar mi lugar
						</EnlaceMessenger>
					</>
				) : (
					<p>Pronto anunciaremos la próxima campaña.</p>
				)
			}
			{
				anterior && (
					<p class="mt-4 border-t border-lineas pt-3 text-texto-secundario">
						Última campaña: {formatearFecha(anterior.data.fecha)}
					</p>
				)
			}
		</div>
		{cartel && <VisorCartel cartel={cartel.imagen} alt={cartel.alt} leyenda={cartel.leyenda} />}
	</div>
</section>

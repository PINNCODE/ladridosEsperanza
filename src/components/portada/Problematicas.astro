---
// Lo que enfrenta un refugio (RF-23). Una cifra solo se muestra con su fecha y su fuente;
// sin las tres, la tarjeta queda con su título y su texto explicativo.
import Icono from '../Icono.astro';
import { cifraVisible, problematicasPublicadas } from '../../lib/datos';
import { formatearMes } from '../../lib/formato';

const problematicas = await problematicasPublicadas();
---

<section id="problematica" aria-labelledby="problematica-titulo" class="aparecer">
	<h2 id="problematica-titulo" class="text-2xl font-bold md:text-3xl">
		Lo que enfrenta un refugio todos los días
	</h2>
	<p class="mt-2 max-w-prose text-texto-secundario">
		Detrás de cada perro y cada gato rescatado hay trabajo, gastos y muchas manos. Estos son los
		retos que enfrentan los refugios.
	</p>
	<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{
			problematicas.map((problematica) => {
				const { data } = problematica;
				return (
					<article class="aparecer flex flex-col gap-2 rounded-2xl border border-lineas bg-superficie p-4">
						<span class="grid size-11 place-items-center rounded-xl bg-suave">
							<Icono nombre={data.icono} />
						</span>
						<h3 class="text-lg font-bold">{data.titulo}</h3>
						<p class="text-texto-secundario">{data.texto}</p>
						{data.enlace && (
							<p class="flex flex-wrap items-center gap-2">
								{data.enlace.sensible && (
									<span class="rounded-full bg-suave px-3 py-1 text-sm font-bold text-sobre-suave">
										Contenido sensible
									</span>
								)}
								<a
									href={data.enlace.url}
									target="_blank"
									rel="noopener"
									class="inline-flex min-h-11 items-center text-acento underline underline-offset-4"
								>
									{data.enlace.texto}
								</a>
							</p>
						)}
						{cifraVisible(problematica) && (
							<div class="mt-auto border-t border-lineas pt-3">
								<p>
									{data.etiqueta_cifra}: <strong class="font-titulos text-lg">{data.cifra}</strong>
								</p>
								<p class="text-sm text-texto-secundario">
									Dato de {formatearMes(data.fecha_cifra!)}. Fuente: {data.fuente}.
								</p>
							</div>
						)}
					</article>
				);
			})
		}
	</div>
</section>

---
// Carrusel de fotos del refugio en la presentación de la portada (SPEC 14). Marco cuadrado:
// cada foto se ve completa sobre una versión difuminada de sí misma, sea vertical u horizontal.
// Si la próxima campaña de esterilización tiene cartel, el cartel va primero y lleva a
// /esterilizacion (SPEC 20). Se desliza con el dedo gracias a scroll-snap; lo demás lo agrega
// `iniciarCarrusel`, que también actualiza el contador.
import { Image } from 'astro:assets';
import Icono from '../Icono.astro';
import { proximaCampana } from '../../lib/datos';
import { formatearFecha } from '../../lib/formato';
import { fotosPortada } from '../../lib/fotosRefugio';
import { medidas } from '../../lib/imagenes';

const campana = await proximaCampana(new Date());
const cartel = campana?.data.cartel ?? null;
const altCartel = campana && `Cartel de la campaña de esterilización del ${formatearFecha(campana.data.fecha)}`;
const conCartel = cartel ? 1 : 0;
const total = fotosPortada.length + conCartel;
---

<div data-carrusel="refugio" role="region" aria-roledescription="carrusel" aria-label="Fotos del refugio">
	<ul
		data-pista
		tabindex="0"
		aria-label="Lista de fotos"
		class="flex snap-x snap-mandatory overflow-x-auto rounded-2xl border border-lineas bg-suave [scrollbar-width:none]"
	>
		{
			cartel && (
				<li
					role="group"
					aria-roledescription="diapositiva"
					aria-label={`1 de ${total}`}
					class="relative aspect-square w-full shrink-0 snap-start overflow-hidden"
				>
					<a
						href="/esterilizacion"
						data-umami-event="abrir_campana"
						data-umami-event-origen="carrusel"
						class="absolute inset-0 block"
					>
						<Image
							src={cartel.url}
							{...medidas(cartel, 48)}
							alt=""
							aria-hidden="true"
							loading="eager"
							class="absolute inset-0 size-full scale-150 object-cover blur-2xl"
						/>
						<Image
							src={cartel.url}
							{...medidas(cartel, 1280)}
							widths={[400, 640, 960, 1280]}
							sizes="(min-width: 768px) 50vw, 100vw"
							alt={altCartel!}
							loading="eager"
							fetchpriority="high"
							class="relative size-full object-contain"
						/>
					</a>
				</li>
			)
		}
		{
			fotosPortada.map((foto, indice) => (
				<li
					role="group"
					aria-roledescription="diapositiva"
					aria-label={`${indice + 1 + conCartel} de ${total}`}
					class="relative aspect-square w-full shrink-0 snap-start overflow-hidden"
				>
					{/* Fondo: la misma foto a 48 px, estirada y difuminada para llenar el marco. */}
					<Image
						src={foto.src}
						width={48}
						alt=""
						aria-hidden="true"
						loading={indice === 0 && !cartel ? 'eager' : 'lazy'}
						class="absolute inset-0 size-full scale-150 object-cover blur-2xl"
					/>
					<Image
						src={foto.src}
						width={1280}
						widths={[400, 640, 960, 1280]}
						sizes="(min-width: 768px) 50vw, 100vw"
						alt={foto.alt}
						loading={indice === 0 && !cartel ? 'eager' : 'lazy'}
						fetchpriority={indice === 0 && !cartel ? 'high' : undefined}
						class="relative size-full object-contain"
					/>
				</li>
			))
		}
	</ul>
	<div class="mt-4 flex items-center justify-center gap-2">
		<button
			type="button"
			data-anterior
			aria-label="Anterior"
			class="grid size-11 shrink-0 place-items-center rounded-full border border-lineas bg-superficie"
		>
			<Icono nombre="chevron-left" size={22} />
		</button>
		{/* Contador en lugar de puntos: veinte puntos no caben junto a las flechas a 360 px. */}
		<p data-contador class="min-w-16 text-center text-sm font-semibold tabular-nums text-texto-secundario">
			1 / {total}
		</p>
		<button
			type="button"
			data-siguiente
			aria-label="Siguiente"
			class="grid size-11 shrink-0 place-items-center rounded-full border border-lineas bg-superficie"
		>
			<Icono nombre="chevron-right" size={22} />
		</button>
	</div>
</div>

<script>
	import { iniciarCarrusel } from '../../lib/carrusel';

	document.querySelectorAll<HTMLElement>('[data-carrusel="refugio"]').forEach(iniciarCarrusel);
</script>

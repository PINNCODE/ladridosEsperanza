---
// Tarjeta de colaboración (RF-28): explica "Come por los Peludos" y lleva al catálogo.
// La portada no muestra ningún negocio; el catálogo vive en /colabora (SPEC 04).
import Icono from '../Icono.astro';
---

<section id="colabora" aria-labelledby="colabora-titulo" class="aparecer pt-11">
	<div
		class="relative flex flex-col gap-5 rounded-3xl border border-lineas bg-superficie p-5 md:flex-row md:items-center md:justify-between md:p-8"
	>
		<span aria-hidden="true" class="absolute -top-11 right-7">
			<Icono nombre="cat" size={54} class="asomarse block" />
		</span>
		<div>
			<span class="grid size-11 place-items-center rounded-xl bg-suave">
				<Icono nombre="store" />
			</span>
			<h2 id="colabora-titulo" class="mt-3 text-2xl font-bold md:text-3xl">
				Come local, ayuda al refugio
			</h2>
			<p class="mt-2 max-w-prose text-texto-secundario">
				"Come por los Peludos" reúne a negocios de la ciudad que publican su menú, horarios y
				promociones, y aportan al refugio. Conoce a los que ya colaboran.
			</p>
		</div>
		<a
			href="/colabora"
			class="inline-flex min-h-11 shrink-0 items-center self-start rounded-xl bg-acento px-5 font-bold text-sobre-acento md:self-center"
		>
			Ver negocios
		</a>
	</div>
</section>

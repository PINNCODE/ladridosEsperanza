---
// Resumen de donativos en la portada: por qué donar y las necesidades vigentes (RF-26).
// La página completa (/donar) llega en la SPEC 03.
import Icono from '../Icono.astro';
import { necesidadesVigentes } from '../../lib/datos';

const necesidades = await necesidadesVigentes(new Date());
---

<section id="donar" aria-labelledby="donar-titulo" class="aparecer">
	<span class="grid size-11 place-items-center rounded-xl bg-suave">
		<Icono nombre="heart" />
	</span>
	<h2 id="donar-titulo" class="mt-3 text-2xl font-bold md:text-3xl">Tu donativo cambia vidas</h2>
	<p class="mt-2 max-w-prose text-texto-secundario">
		Cuidar animales cuesta todos los días. Cada aporte, grande o pequeño, se convierte en comida,
		atención veterinaria, esterilizaciones y rescates.
	</p>
	{
		necesidades.length > 0 && (
			<div class="mt-5 max-w-md rounded-2xl border border-lineas bg-superficie p-5">
				<h3 class="text-lg font-bold">Necesidades del mes</h3>
				<ul class="mt-2 divide-y divide-lineas">
					{necesidades.map(({ data }) => (
						<li class="flex items-center justify-between gap-4 py-2">
							<span>{data.descripcion}</span>
							{data.urgencia === 'urgente' ? (
								<span class="rounded-full bg-acento px-3 py-1 text-sm font-bold text-sobre-acento">
									Urgente
								</span>
							) : (
								<span class="rounded-full bg-suave px-3 py-1 text-sm text-sobre-suave">Necesaria</span>
							)}
						</li>
					))}
				</ul>
			</div>
		)
	}
	<a
		href="/donar"
		class="mt-5 inline-flex min-h-11 items-center rounded-xl bg-acento px-5 font-bold text-sobre-acento"
	>
		Ver cómo ayudar
	</a>
</section>

---
// Resumen de esterilización en la portada: por qué esterilizar y la próxima campaña.
// La página completa es /esterilizacion (SPEC 03). La foto de la camada es de la SPEC 14.
import { Image } from 'astro:assets';
import EnlaceMessenger from '../EnlaceMessenger.astro';
import Icono from '../Icono.astro';
import { proximaCampana } from '../../lib/datos';
import { fotosRefugio } from '../../lib/fotosRefugio';
import { formatearFecha, formatearPesos } from '../../lib/formato';

const campana = await proximaCampana(new Date());

const datos = campana && [
	{ etiqueta: 'Próxima campaña', valor: formatearFecha(campana.data.fecha) },
	{ etiqueta: 'Costo', valor: formatearPesos(campana.data.costo) },
	{ etiqueta: 'Lugar', valor: campana.data.lugar },
	{ etiqueta: 'Horario', valor: campana.data.horario },
	...(campana.data.cupo !== null ? [{ etiqueta: 'Cupo', valor: `${campana.data.cupo} lugares` }] : []),
];

const reservar =
	campana && `Hola, quiero reservar un lugar para la campaña de esterilización del ${formatearFecha(campana.data.fecha)}.`;
---

<section id="esterilizacion" aria-labelledby="esterilizacion-titulo" class="aparecer pt-11">
	<div class="relative grid gap-6 rounded-3xl bg-suave p-5 md:grid-cols-2 md:p-8">
		<span aria-hidden="true" class="absolute -top-11 left-7">
			<Icono nombre="dog" size={54} class="asomarse block" />
		</span>
		<div>
			<span class="grid size-11 place-items-center rounded-xl bg-superficie">
				<Icono nombre="syringe" />
			</span>
			<h2 id="esterilizacion-titulo" class="mt-3 text-2xl font-bold md:text-3xl">
				Esterilizar salva vidas
			</h2>
			<p class="mt-2 text-sobre-suave">
				La esterilización es una de las formas más efectivas de reducir el abandono a largo plazo:
				evita camadas que después no encuentran hogar. El refugio organiza campañas para perros y
				gatos.
			</p>
			<Image
				src={fotosRefugio.gataConSuCamada.src}
				width={960}
				widths={[320, 480, 640, 960]}
				sizes="(min-width: 768px) 384px, 100vw"
				alt={fotosRefugio.gataConSuCamada.alt}
				style={{ objectPosition: fotosRefugio.gataConSuCamada.enfoque }}
				class="mt-4 aspect-square md:max-w-sm w-full rounded-2xl object-cover"
			/>
		</div>
		<div class="rounded-2xl bg-superficie p-5">
			{
				datos ? (
					<dl class="divide-y divide-lineas">
						{datos.map(({ etiqueta, valor }) => (
							<div class="flex justify-between gap-4 py-2">
								<dt class="text-texto-secundario">{etiqueta}</dt>
								<dd class="text-right font-bold">{valor}</dd>
							</div>
						))}
					</dl>
				) : (
					<p>Pronto anunciaremos la próxima campaña.</p>
				)
			}
			<div class="mt-4 flex flex-wrap items-center gap-3">
				{
					reservar && (
						<EnlaceMessenger
							mensaje={reservar}
							motivo="esterilizacion"
							class="inline-flex min-h-11 items-center rounded-xl bg-acento px-5 font-bold text-sobre-acento"
						>
							Reservar mi lugar
						</EnlaceMessenger>
					)
				}
				<a
					href="/esterilizacion"
					class="inline-flex min-h-11 items-center px-1 text-acento underline underline-offset-4"
				>
					Más sobre esterilización
				</a>
			</div>
		</div>
	</div>
</section>

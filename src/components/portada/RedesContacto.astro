---
// Redes y contacto: las cuatro redes del refugio (enlazadas, no incrustadas) y su WhatsApp.
import { obtener, obtenerRefugio } from '../../lib/datos';
import { enlaceWhatsApp } from '../../lib/whatsapp';

const refugio = await obtenerRefugio();
const redes = (await obtener('redes')).sort((a, b) => a.data.orden - b.data.orden);
const whatsapp = enlaceWhatsApp(refugio.whatsapp, `Hola, les escribo desde la página de ${refugio.nombre}.`);
---

<section id="redes" aria-labelledby="redes-titulo" class="aparecer">
	<h2 id="redes-titulo" class="text-2xl font-bold md:text-3xl">Síguenos y escríbenos</h2>
	<p class="mt-2 max-w-prose text-texto-secundario">
		Mira el día a día del refugio en sus redes o escríbenos directo.
	</p>
	<ul class="mt-5 flex flex-wrap gap-2">
		<li>
			<a
				href={whatsapp}
				data-umami-event="whatsapp"
				data-umami-event-motivo="contacto"
				target="_blank"
				rel="noopener"
				class="inline-flex min-h-11 items-center rounded-xl bg-acento px-5 font-bold text-sobre-acento"
			>
				Escríbenos por WhatsApp
			</a>
		</li>
		{
			redes.map(({ data }) => (
				<li>
					<a
						href={data.url}
						target="_blank"
						rel="noopener"
						class="inline-flex min-h-11 items-center rounded-xl border border-acento bg-superficie px-4 font-bold text-acento"
					>
						{data.etiqueta}
					</a>
				</li>
			))
		}
	</ul>
</section>

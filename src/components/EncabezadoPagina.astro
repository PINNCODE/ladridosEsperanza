---
// Encabezado de las páginas del refugio (SPEC 03): ícono, el único <h1> de la página y su frase.
import Icono from './Icono.astro';

interface Props {
	titulo: string;
	frase: string;
	/** Nombre de Lucide en kebab-case; es decorativo. */
	icono: string;
}

const { titulo, frase, icono } = Astro.props;
---

<header class="pt-8 pb-2">
	<span class="grid size-12 place-items-center rounded-xl bg-suave">
		<Icono nombre={icono} />
	</span>
	<h1 class="mt-4 text-3xl leading-tight font-extrabold md:text-4xl">{titulo}</h1>
	<p class="mt-3 max-w-prose text-lg text-texto-secundario">{frase}</p>
</header>

---
// Encabezado de las páginas del refugio (SPEC 03): ícono, el único <h1> de la página y su frase.
// Con `foto` (SPEC 14), la foto va a la derecha desde md y debajo de la frase en teléfono.
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import type { FotoRefugio } from '../lib/fotosRefugio';

interface Props {
	titulo: string;
	frase: string;
	/** Nombre de Lucide en kebab-case; es decorativo. */
	icono: string;
	foto?: FotoRefugio;
}

const { titulo, frase, icono, foto } = Astro.props;
---

<header class:list={['pt-8 pb-2', foto && 'grid items-center gap-6 md:grid-cols-2']}>
	<div>
		<span class="grid size-12 place-items-center rounded-xl bg-suave">
			<Icono nombre={icono} />
		</span>
		<h1 class="mt-4 text-3xl leading-tight font-extrabold md:text-4xl">{titulo}</h1>
		<p class="mt-3 max-w-prose text-lg text-texto-secundario">{frase}</p>
	</div>
	{
		foto && (
			<Image
				src={foto.src}
				width={1280}
				widths={[400, 640, 960, 1280]}
				sizes="(min-width: 768px) 50vw, 100vw"
				alt={foto.alt}
				loading="eager"
				style={{ objectPosition: foto.enfoque }}
				class="aspect-[4/3] w-full rounded-2xl border border-lineas object-cover"
			/>
		)
	}
</header>

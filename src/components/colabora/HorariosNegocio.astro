---
// Horarios de un negocio por día (SPEC 05, RF-07): turnos, cruce de medianoche, "Cerrado"
// y "Por confirmar". El script marca la fila de hoy con la fecha de Ciudad de México.
import { textoDia, type Dia, type Horarios } from '../../lib/horarios';

interface Props {
	horarios: Horarios;
}

const { horarios } = Astro.props;

const dias: { dia: Dia; nombre: string }[] = [
	{ dia: 'lun', nombre: 'Lunes' },
	{ dia: 'mar', nombre: 'Martes' },
	{ dia: 'mie', nombre: 'Miércoles' },
	{ dia: 'jue', nombre: 'Jueves' },
	{ dia: 'vie', nombre: 'Viernes' },
	{ dia: 'sab', nombre: 'Sábado' },
	{ dia: 'dom', nombre: 'Domingo' },
];
---

<section
	id="horarios"
	aria-labelledby="horarios-titulo"
	data-horarios-negocio
	class="scroll-mt-4 rounded-2xl border border-lineas bg-superficie p-5"
>
	<h2 id="horarios-titulo" class="text-xl font-bold">Horarios</h2>
	<table class="mt-3 w-full text-left">
		<tbody>
			{
				dias.map(({ dia, nombre }) => (
					<tr data-dia={dia} class="border-t border-lineas first:border-t-0 aria-[current=date]:font-bold">
						<th scope="row" class="py-2 pr-3 font-normal [tr[aria-current=date]_&]:font-bold">
							{nombre}
							<span data-hoy hidden class="ml-1 rounded-full bg-suave px-2 py-0.5 text-xs font-bold text-sobre-suave">
								Hoy
							</span>
						</th>
						<td class="py-2 text-right">{textoDia(horarios[dia])}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</section>

<script>
	import { momentoEnMexico } from '../../lib/horarios';

	const filas = [...document.querySelectorAll<HTMLElement>('[data-horarios-negocio] [data-dia]')];

	/** Marca el día de hoy en Ciudad de México, aunque el turno abierto sea del día anterior. */
	function marcarHoy() {
		const { dia } = momentoEnMexico(new Date());
		for (const fila of filas) {
			const esHoy = fila.dataset.dia === dia;
			if (esHoy) fila.setAttribute('aria-current', 'date');
			else fila.removeAttribute('aria-current');
			fila.querySelector<HTMLElement>('[data-hoy]')!.hidden = !esHoy;
		}
	}

	if (filas.length > 0) {
		marcarHoy();
		setInterval(marcarHoy, 60_000);
	}
</script>

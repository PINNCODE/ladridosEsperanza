---
// Carrusel de peludos en adopción (RF-30). Se desliza con el dedo gracias a
// scroll-snap; flechas, puntos, teclado y avance automático los agrega `iniciarCarrusel` (SPEC 14).
// Cada tarjeta trae su corazón de "me gusta" (SPEC 13).
import Icono from './Icono.astro';
import TarjetaPeludo from './TarjetaPeludo.astro';
import type { Peludo } from '../lib/datos';

interface Props {
	peludos: Peludo[];
}

const { peludos } = Astro.props;
---

<div data-carrusel="peludos" role="region" aria-roledescription="carrusel" aria-label="Peludos en adopción">
	<ul
		data-pista
		tabindex="0"
		aria-label="Lista de peludos"
		class="flex snap-x snap-mandatory gap-4 overflow-x-auto rounded-2xl pb-1 [scrollbar-width:none]"
	>
		{
			peludos.map((peludo) => (
				<li class="w-[80%] max-w-80 shrink-0 snap-start">
					<TarjetaPeludo peludo={peludo} origen="portada" />
				</li>
			))
		}
	</ul>
	<div class="mt-4 flex items-center justify-center gap-2">
		<button
			type="button"
			data-anterior
			aria-label="Anterior"
			class="grid size-11 shrink-0 place-items-center rounded-full border border-lineas bg-superficie"
		>
			<Icono nombre="chevron-left" size={22} />
		</button>
		{/* Puntos de 44 px de alto y 28 de ancho: seis caben junto a las flechas dentro de la banda a 360 px. */}
		<div class="flex flex-wrap justify-center">
			{
				peludos.map(({ data }, indice) => (
					<button
						type="button"
						data-punto={indice}
						aria-label={`Ver a ${data.nombre}`}
						aria-current={indice === 0 ? 'true' : undefined}
						class="group grid h-11 w-7 place-items-center rounded-full"
					>
						<span class="block h-2.5 w-2.5 rounded-full bg-lineas group-aria-[current=true]:w-6 group-aria-[current=true]:bg-acento" />
					</button>
				))
			}
		</div>
		<button
			type="button"
			data-siguiente
			aria-label="Siguiente"
			class="grid size-11 shrink-0 place-items-center rounded-full border border-lineas bg-superficie"
		>
			<Icono nombre="chevron-right" size={22} />
		</button>
	</div>
</div>

<script>
	import { iniciarCarrusel } from '../lib/carrusel';

	document.querySelectorAll<HTMLElement>('[data-carrusel="peludos"]').forEach(iniciarCarrusel);
</script>
